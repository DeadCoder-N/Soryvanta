# Auth
AUTH_SECRET=<generate_with: openssl rand -base64 32>
NEXTAUTH_URL=http://localhost:3000

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres

# ── OpenWA WhatsApp provider (active) ──────────────────────────────────────
# Base URL of the OpenWA gateway REST API. Local default; override for a
# remote/self-hosted gateway.
OPENWA_API_BASE_URL=http://127.0.0.1:2785/api
# API key generated by the OpenWA gateway (X-API-Key header). NEVER commit.
OPENWA_API_KEY=
# UUID of the created OpenWA session (marketing-os-secondary).
OPENWA_SESSION_ID=
# HMAC-SHA256 signing secret set on the OpenWA webhook. NEVER commit.
OPENWA_WEBHOOK_SECRET=
# Webhook endpoint reachable from the OpenWA runtime.
OPENWA_WEBHOOK_URL=http://127.0.0.1:3000/api/whatsapp/webhook
# Set explicitly to "aisensy" to keep the legacy AiSensy path for a manual
# rollback. When OPENWA_API_KEY + OPENWA_SESSION_ID are set, OpenWA is the
# required provider (no silent fallback).
WHATSAPP_PROVIDER=openwa

# ── AiSensy (kept for manual rollback only) ────────────────────────────────
# AISENSY_API_KEY=
# AISENSY_PROJECT_API_KEY=
# AISENSY_PROJECT_ID=
# AISENSY_PHONE_NUMBER=
# AISENSY_CAMPAIGN_NAME=your_existing_live_campaign_name

# Anthropic AI (optional — system works without it)
ANTHROPIC_API_KEY=<your_anthropic_api_key>

# Cloudinary (optional — for image uploads)
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_cloudinary_api_key>
CLOUDINARY_API_SECRET=<your_cloudinary_api_secret>