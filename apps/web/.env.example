# Auth
AUTH_SECRET=<generate_with: openssl rand -base64 32>
NEXTAUTH_URL=http://localhost:3000

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres

# AiSensy WhatsApp API
AISENSY_API_KEY=<your_aisensy_campaign_api_key>
AISENSY_PHONE_NUMBER=<your_aisensy_whatsapp_number>

# Anthropic AI (optional — system works without it)
ANTHROPIC_API_KEY=<your_anthropic_api_key>

# Cloudinary (optional — for image uploads)
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_cloudinary_api_key>
CLOUDINARY_API_SECRET=<your_cloudinary_api_secret>
