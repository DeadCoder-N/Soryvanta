generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BROKER
  ADMIN
  SUPER_ADMIN
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  PLOT
  COMMERCIAL
  OTHER
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  SOLD
  RENTED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum OtpPurpose {
  PHONE_VERIFICATION
  LOGIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  phone         String?   @unique
  countryCode   String    @default("+91")              // NEW: Country dial code for phone
  phoneVerified Boolean   @default(false)               // NEW: Whether phone is OTP-verified
  passwordHash  String?
  role          Role      @default(BROKER)
  plan          String?   @default("STARTER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  properties        Property[]
  whatsappMessages  WhatsappMessage[]
  sessions          Session[]
  accounts          Account[]
  otps              OtpVerification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Property {
  id          String         @id @default(cuid())
  slug        String         @unique
  ownerId     String?
  ownerPhone  String?
  title       String
  description String
  address     String
  city        String
  price       Int
  priceLabel  String?
  bedrooms    Int?
  bathrooms   Int?
  areaSqft    Int?
  type        PropertyType   @default(APARTMENT)
  status      PropertyStatus @default(ACTIVE)
  features    String[]
  amenities   String[]
  rawInput    String?
  mockDataUrl String?                   // URL to Flask mock JSON for fallback
  mediaJson   Json?                     // [{url, type, caption, order}] images+videos
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  owner     User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  images    Image[]
  leads     Lead[]
  analytics Analytics?

  @@index([ownerId])
  @@index([ownerPhone])
  @@index([city])
  @@index([status])
}

model Image {
  id           String   @id @default(cuid())
  propertyId   String
  url          String
  thumbnailUrl String?
  caption      String?
  order        Int      @default(0)
  mediaType    String   @default("image")          // "image" | "video"
  createdAt    DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Lead {
  id          String   @id @default(cuid())
  propertyId  String
  name        String?
  phone       String?
  countryCode String   @default("+91")             // Country dial code
  tokenCount  Int      @default(0)                 // Message char count for analytics
  message     String?
  source      String   @default("whatsapp")
  createdAt   DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([phone])
  @@unique([propertyId, phone, createdAt])          // Duplicate prevention
}

model Analytics {
  id           String   @id @default(cuid())
  propertyId   String   @unique
  viewCount    Int      @default(0)
  inquiryCount Int      @default(0)
  lastViewed   DateTime?
  updatedAt    DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model WhatsappMessage {
  id        String          @id @default(cuid())
  userId    String?
  waId      String
  content   String
  direction MessageDirection
  status    String?
  timestamp DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([waId])
}

model ConversationState {
  id            String    @id @default(cuid())
  userId        String    @unique
  state         String
  context       Json?
  lastMessageAt DateTime @default(now())

  @@index([userId])
}

// NEW: OTP Verification for phone number verification
model OtpVerification {
  id        String     @id @default(cuid())
  userId    String?
  phone     String
  countryCode String   @default("+91")
  otp       String
  purpose   OtpPurpose @default(PHONE_VERIFICATION)
  attempts  Int        @default(0)
  expiresAt DateTime
  verified  Boolean    @default(false)
  createdAt DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([userId])
}