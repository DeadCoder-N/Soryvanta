generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  phone         String?   @unique
  passwordHash  String?
  role          Role      @default(BROKER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  properties        Property[]
  whatsappMessages  WhatsappMessage[]
  sessions          Session[]
  accounts          Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Property {
  id          String         @id @default(cuid())
  slug        String         @unique
  ownerId     String?
  ownerPhone  String?
  title       String
  description String
  address     String
  city        String
  price       Int
  priceLabel  String?
  bedrooms    Int?
  bathrooms   Int?
  areaSqft    Int?
  type        PropertyType   @default(APARTMENT)
  status      PropertyStatus @default(ACTIVE)
  features    String[]
  amenities   String[]
  rawInput    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  owner     User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  images    Image[]
  leads     Lead[]
  analytics Analytics?

  @@index([ownerId])
  @@index([ownerPhone])
  @@index([city])
  @@index([status])
}

model Image {
  id          String   @id @default(cuid())
  propertyId  String
  url         String
  thumbnailUrl String?
  caption     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Lead {
  id         String   @id @default(cuid())
  propertyId String
  name       String?
  phone      String?
  message    String?
  source     String   @default("whatsapp")
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Analytics {
  id           String   @id @default(cuid())
  propertyId   String   @unique
  viewCount    Int      @default(0)
  inquiryCount Int      @default(0)
  lastViewed   DateTime?
  updatedAt    DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model WhatsappMessage {
  id        String          @id @default(cuid())
  userId    String?
  waId      String
  content   String
  direction MessageDirection
  status    String?
  timestamp DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([waId])
}

enum Role {
  BROKER
  ADMIN
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  PLOT
  COMMERCIAL
  OTHER
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  SOLD
  RENTED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model ConversationState {
  id            String    @id @default(cuid())
  userId        String    @unique
  state         String
  context       Json?
  lastMessageAt DateTime @default(now())

  @@index([userId])
}
